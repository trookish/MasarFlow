{
  "name": "masarflow",
  "version": "0.1.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:full": "node scripts/start.mjs --dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "setup:python": "node scripts/start.mjs --setup-only",
    "tools:install": "node scripts/install-opencode-tools.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "e2e": "playwright test --config tests/playwright.config.ts",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:start": "npm --prefix desktop run start",
    "desktop:dist": "npm --prefix desktop run dist",
    "desktop:typecheck": "npm --prefix desktop run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@xyflow/react": "^12.11.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "fuse.js": "^7.4.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.30.0",
    "mermaid": "^11.16.1",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
