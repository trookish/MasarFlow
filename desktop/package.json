{
  "name": "masarflow-desktop",
  "version": "0.3.0",
  "description": "MasarFlow desktop application",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "6.8.10",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3"
  }
}
