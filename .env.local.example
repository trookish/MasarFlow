# Base URL of the local Python AI service (python-service/). Required — the
# workspace shell shows a setup screen until the service is reachable. Only
# change this if you run the service on a non-default port. See
# python-service/README.md.
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# ── OpenCode agent backend (chat) ─────────────────────────────────────────
# The chat system runs on OpenCode's headless server. start.mjs spawns it
# automatically unless it is already reachable at OPENCODE_BASE_URL (or you
# set OPENCODE_AUTO_START=false and run `opencode serve` yourself).

# Base URL of the OpenCode server the backend talks to. When start.mjs spawns
# the server it overrides this with the port it actually bound (4096 is often
# occupied — it falls forward to the next free port, like the Python service).
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Credentials the MasarFlow backend uses to authenticate to the OpenCode
# server (HTTP basic auth). Leave empty when the server runs unsecured on the
# loopback interface.
# OPENCODE_USERNAME=opencode
# OPENCODE_PASSWORD=

# Server auth applied when start.mjs spawns `opencode serve`. If only
# OPENCODE_PASSWORD is set, it is reused as the server password so the client
# credentials above actually authenticate.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# Whether start.mjs should spawn the OpenCode server when it isn't reachable.
# OPENCODE_AUTO_START=true
# Preferred port for the spawned server (falls forward when occupied).
# OPENCODE_PORT=4096

# Default working directory for OpenCode sessions (fs/shell/file tools).
# Defaults to the MasarFlow project root. Chat threads linked to an external
# project (e.g. a Unity folder) use that project's root instead.
# OPENCODE_WORKSPACE_DIR=C:\path\to\workspace

# Per-session tool permission rules passed to OpenCode (approvals appear in
# the chat UI). Values: ask | allow | deny.
# OPENCODE_PERMISSION_EDIT=ask
# OPENCODE_PERMISSION_BASH=ask
# OPENCODE_PERMISSION_WEBFETCH=ask

# Turn watchdogs (milliseconds): time before the first event, silence between
# events, and the whole turn budget.
# MASARFLOW_OPENCODE_FIRST_EVENT_TIMEOUT_MS=30000
# MASARFLOW_OPENCODE_IDLE_TIMEOUT_MS=60000
# MASARFLOW_OPENCODE_TOTAL_TIMEOUT_MS=300000

# Provider/model catalog cache TTL from the OpenCode server (milliseconds).
# OPENCODE_MODEL_CACHE_TTL_MS=60000

# ---- MasarFlow workspace tools in OpenCode (the browser bridge) ----
# Every workspace function (create_note, read_spec, ...) is installed as a
# real opencode custom tool (.opencode/tools/*.ts + ~/.config/opencode/tools).
# opencode calls them back into this server, which relays to the open browser
# over SSE; the browser executes them against IndexedDB.

# Base URL the generated opencode tools call back to. Defaults to
# http://127.0.0.1:3000 (or PORT). Only change when Next serves elsewhere.
# MASARFLOW_BRIDGE_URL=http://127.0.0.1:3000

# Shared secret authenticating the generated opencode tools to the bridge
# routes. start.mjs auto-generates one (stored in .masarflow/bridge-secret)
# — you only need to set this when running the Next server and opencode in
# separate setups.
# MASARFLOW_BRIDGE_SECRET=

# Install the workspace tools into the global opencode config dir
# (~/.config/opencode/tools) as well as the project dir. Default true.
# OPENCODE_TOOLS_GLOBAL=true
